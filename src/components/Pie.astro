---
import { AUTOR, MARCA } from "../configuracion.mjs";
import { t, ruta, type Lang, type Imagen } from "../lib/sitio";

interface Props {
  lang: Lang;
  imagenes?: Imagen[]; // imágenes que aparecen en la página, para sus créditos
}
const { lang, imagenes = [] } = Astro.props;
const creditos = [...new Map(imagenes.map((i) => [i.credit, i])).values()]; // un crédito por autor
---

<footer class="pie">
  <div class="envoltorio">
    <a href={ruta("portada", lang)} class="pie__logo" aria-label={t("portada", lang)}>
      <span class="pie__nombre"><svg class="pie__icona" viewBox="0 0 100 100" aria-hidden="true"><polyline points="8,62 50,24 92,62" fill="none" stroke="currentColor" stroke-width="11" stroke-linejoin="miter"/><rect x="8" y="74" width="84" height="12" fill="#C8412F"/></svg>{MARCA}</span>
    </a>
    <p class="rotulo pie__lema">{t("subtitulo", lang)} · {t("unProyectoDe", lang)} {AUTOR}</p>
    <ul class="pie__enlaces">
      <li><a class="rotulo" href={ruta("contacto", lang)}>{t("contacto", lang)}</a></li>
      <li><a class="rotulo" href={ruta("privacidad", lang)}>{t("privacidad", lang)}</a></li>
      <li><a class="rotulo" href={ruta("rss", lang)}>RSS</a></li>
      <li><a class="rotulo" href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" rel="license">{t("licencia", lang)}</a></li>
    </ul>
    {creditos.length > 0 && (
      <p class="pie__creditos rotulo">
        <span>{t("creditosFotos", lang)}:</span>
        {creditos.map((i, n) => (
          <>
            <a href={i.source}>{i.credit}</a>{n < creditos.length - 1 ? " · " : " "}
          </>
        ))}
        <span class="pie__gris">{t("copiasReducidas", lang)}</span>
      </p>
    )}
  </div>
</footer>

<style>
  .pie {
    background: var(--papel);
    border-top: 2px solid var(--grafito);
    color: var(--grafito);
    padding: 2.25rem 0 2rem;
  }
  .pie__logo { text-decoration: none; }
  .pie__nombre { display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--f-titulo); font-weight: 700; text-transform: uppercase; font-size: 1.4rem; line-height: 1; color: var(--grafito); }
  .pie__icona { width: 32px; height: 32px; }
  .pie__lema { color: var(--gris); margin: 1rem 0 1.4rem; }
  .pie__enlaces {
    list-style: none; margin: 0; padding: 1.2rem 0 0; border-top: 1px solid var(--filete);
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem;
  }
  .pie a { text-decoration: none; }
  .pie a:hover { color: var(--rojo-texto); }
  .pie__creditos { margin-top: 1rem; line-height: 1.8; }
  .pie__creditos > span:first-child { margin-right: 0.5rem; }
  .pie__gris { color: var(--gris); }
</style>
