---
// Primera pantalla de la portada (propuesta «la casa de papel», 23-11-2026):
// el lema a la izquierda y, a la derecha, una foto de aula recortada con tejado
// a dos aguas sobre la barra roja: el logotipo convertido en edificio (oîkos).
import imagenes from "../datos/imagenes.json";
import { AUTOR, MARCA } from "../configuracion.mjs";
import { t, ruta, copiasDe, type Lang } from "../lib/sitio";

interface Props { lang: Lang }
const { lang } = Astro.props;
const foto = imagenes.images.find((i) => i.key === "racionamiento")!;
const T = {
  es: { rotulo: "Didáctica de la economía", l1: "Aprender economía", l2: "haciendo economía", b1: "Entra en la investigación", b2: "Propuestas de aula" },
  ca: { rotulo: "Didàctica de l’economia", l1: "Aprendre economia", l2: "fent economia", b1: "Entra a la recerca", b2: "Propostes d’aula" },
}[lang];
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="envoltorio hero__in">
    <div>
      <p class="rotulo rotulo--rojo">{MARCA} · {T.rotulo}</p>
      <h1 id="hero-titulo"><span>{T.l1}</span><span>{T.l2}</span></h1>
      <p class="hero__entrada">{t("portadillaTexto", lang)}</p>
      <p class="hero__acciones">
        <a class="boton" href={ruta("didactica", lang)}>{T.b1}</a>
        <a class="boton boton--contorno" href={ruta("aula", lang)}>{T.b2}</a>
      </p>
      <p class="hero__firma rotulo"><a href={ruta("sobreMi", lang)}>{t("unProyectoDe", lang)} {AUTOR}</a></p>
    </div>
    <figure class="casa">
      <div class="foto-papel casa__foto">
        <img {...copiasDe(foto)} sizes="(max-width: 759px) 100vw, 50vw" alt={foto.alt[lang]} width={foto.width} height={foto.height} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="casa__base" aria-hidden="true"></div>
      <figcaption class="casa__pie">
        <span>{foto.alt[lang]}</span>
        <a class="rotulo" href={foto.source}>{foto.credit}</a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.25rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4.25rem); }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  h1 { font-size: clamp(2.9rem, 5.35vw, 4.6rem); line-height: 0.94; text-transform: uppercase; letter-spacing: -0.012em; margin: 1.1rem 0 1.6rem; }
  h1 span { display: block; }
  .hero__entrada { font-size: clamp(1.15rem, 1.6vw, 1.3rem); line-height: 1.55; max-width: 33rem; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.9rem; }
  .hero__firma { margin-top: 2rem; display: flex; align-items: center; gap: 0.75rem; }
  .hero__firma::before { content: ""; width: 2.25rem; height: 2px; background: var(--grafito); }
  .hero__firma a { text-decoration: none; border-bottom: 1px solid var(--gris); }
  .hero__firma a:hover { border-bottom: 2px solid var(--rojo); }
  .casa { margin: 0; }
  .casa__foto { aspect-ratio: 1 / 0.88; clip-path: polygon(0 15%, 50% 0, 100% 15%, 100% 100%, 0 100%); }
  .casa__foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .casa__base { height: 14px; background: var(--rojo); margin-top: 11px; }
  .casa__pie {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; justify-content: space-between;
    margin-top: 0.7rem; font: 400 0.85rem/1.45 var(--f-lectura); color: var(--gris);
  }
  .casa__pie a { color: var(--gris); text-decoration: none; font-size: 0.7rem; }
  .casa__pie a:hover { color: var(--rojo-texto); }
  @media (max-width: 820px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); }
    .casa__foto { aspect-ratio: 4 / 3; }
    .casa__pie span { display: none; }
  }
</style>
