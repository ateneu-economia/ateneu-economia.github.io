---
// Lista de artículos: categoría y fecha en una línea, título en Archivo Narrow y extracto en gris.
// Con «imagenes», cada fila lleva su foto sobre papel (Didáctica, Aula).
import {
  t, rutaArticulo, fecha, fechaISO, nombreCategoria, imagenDe, copiasDe, type Articulo, type Lang,
} from "../lib/sitio";

interface Props {
  lang: Lang;
  articulos: Articulo[];
  categoria?: boolean; // mostrar la categoría de cada artículo
  imagenes?: boolean;
  vacio?: string;      // texto si no hay ninguno
  nivel?: 2 | 3;
}
const { lang, articulos, categoria = false, imagenes = false, vacio = t("nadaPublicado", lang), nivel = 2 } = Astro.props;
const Titulo = `h${nivel}`;
---

{articulos.length === 0 ? (
  <p class="vacio">{vacio}</p>
) : (
  <ul class:list={["lista", { "lista--imagenes": imagenes }]}>
    {articulos.map((a) => {
      const img = imagenes ? imagenDe(a) : undefined;
      return (
        <li class="fila">
          <div class="fila__texto">
            <p class="fila__meta rotulo">
              {categoria && <span class="rotulo--rojo">{nombreCategoria(a.data.category, lang)}</span>}
              <time class="rotulo--gris" datetime={fechaISO(a.data.date)}>{fecha(a.data.date, lang)}</time>
            </p>
            <Titulo class="fila__titulo"><a href={rutaArticulo(a)}>{a.data.title}</a></Titulo>
            {a.data.excerpt && <p class="fila__extracto">{a.data.excerpt}</p>}
          </div>
          {img && (
            <div class="foto-papel fila__foto">
              <img {...copiasDe(img)} sizes="(max-width: 759px) 100vw, 200px" alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />
            </div>
          )}
        </li>
      );
    })}
  </ul>
)}

<style>
  .lista { list-style: none; margin: 0; padding: 0; }
  .fila {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.4rem 0 1.5rem;
    border-bottom: 1px solid var(--filete);
  }
  .lista--imagenes .fila { grid-template-columns: minmax(0, 1fr) 200px; }
  .fila__meta { display: flex; flex-wrap: wrap; gap: 0.2rem 0.55rem; white-space: nowrap; }
  .fila__meta span + time::before { content: "·"; margin-right: 0.55rem; color: var(--gris); }
  .fila__titulo {
    font: 700 1.45rem/1.15 var(--f-titulo);
    letter-spacing: -0.005em;
    margin: 0.65rem 0 0.6rem;
  }
  .fila__titulo a { text-decoration: none; }
  .fila__titulo a:hover { color: var(--rojo-texto); }
  .fila__extracto { color: var(--gris); font-size: 0.95rem; line-height: 1.6; max-width: 44rem; }
  .fila__foto { align-self: start; aspect-ratio: 4 / 3; }
  .fila__foto img { width: 100%; height: 100%; object-fit: cover; }
  .vacio { color: var(--gris); font-size: 1.15rem; margin: 1rem 0 1.5rem; }

  @media (max-width: 759px) {
    .lista--imagenes .fila { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; }
    .fila__titulo { font-size: 1.35rem; }
    .fila__foto { grid-row: 1; aspect-ratio: 16 / 9; }
  }
</style>
