---
// Portada: la presentación (lema y casa) y, debajo, una sola columna del ancho de la web
// (revisión 23-11-2026): las últimas lecturas a lo ancho y, al final, quién escribe y RSS.
// Sin barra lateral ni tarjeta de «Qué investigo», que repetía la entradilla de arriba.
import Base from "../layouts/Base.astro";
import imagenesBanco from "../datos/imagenes.json";
import Presentacion from "../components/Presentacion.astro";
import {
  t, ruta, rutaArticulo, articulosDe, fecha, fechaISO, nombreCategoria, otro,
  type Lang,
} from "../lib/sitio";

interface Props { lang: Lang }
const { lang } = Astro.props;
const todos = await articulosDe(lang);
// Primero los destacados; después, lo más reciente. Las notas de trabajo (teoría) no van a portada.
const orden = [
  ...todos.filter((a) => a.data.featured),
  ...todos.filter((a) => !a.data.featured && a.data.category !== "teoria"),
];
const [destacado, ...tarjetas] = orden;
---

<Base lang={lang} otraLengua={ruta("portada", otro(lang))} imagenes={imagenesBanco.images.filter((i) => i.key === "racionamiento")}>
  <Presentacion lang={lang} />

  <div class="envoltorio portada">
    {destacado && (
      <section class="lecturas" aria-labelledby="lecturas-titulo">
        <div class="lecturas__cabecera">
          <h2 id="lecturas-titulo">{t("ultimasLecturas", lang)}</h2>
          <a class="rotulo enlace-subrayado" href={ruta("articulos", lang)}>{t("archivoCompleto", lang)}</a>
        </div>

        <article class="destacado">
          <div>
            <p class="meta rotulo">
              <span class="rotulo--rojo">{nombreCategoria(destacado.data.category, lang)}</span>
              <time class="rotulo--gris" datetime={fechaISO(destacado.data.date)}>{fecha(destacado.data.date, lang)}</time>
            </p>
            <h3 class="destacado__titulo"><a href={rutaArticulo(destacado)}>{destacado.data.title}</a></h3>
          </div>
          <div class="destacado__cuerpo">
            <p class="destacado__extracto">{destacado.data.excerpt}</p>
            <a class="boton" href={rutaArticulo(destacado)} aria-label={`${t("leer", lang)}: ${destacado.data.title}`}>{t("leer", lang)}</a>
          </div>
        </article>

        {tarjetas.length > 0 && (
          <ul class="tarjetas">
            {tarjetas.slice(0, 3).map((a) => (
              <li class="tarjeta">
                <p class="meta rotulo">
                  <span class="rotulo--rojo">{nombreCategoria(a.data.category, lang)}</span>
                  <time class="rotulo--gris" datetime={fechaISO(a.data.date)}>{fecha(a.data.date, lang)}</time>
                </p>
                <h3 class="tarjeta__titulo"><a href={rutaArticulo(a)}>{a.data.title}</a></h3>
                <p class="tarjeta__extracto">{a.data.excerpt}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    <div class="cierre">
      <section class="caja">
        <h2 class="caja__titulo">{t("quienEscribe", lang)}</h2>
        <p class="caja__texto">{t("quienEscribeTexto", lang)}</p>
        <a class="rotulo enlace-subrayado" href={ruta("sobreMi", lang)}>{t("masSobreMi", lang)}</a>
      </section>
      <section class="caja">
        <h2 class="caja__titulo">{t("seguirNovedades", lang)}</h2>
        <p class="caja__texto">{t("rssTexto", lang)}</p>
        <a class="boton boton--contorno" href={ruta("rss", lang)}>
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><circle cx="3" cy="13" r="2" fill="currentColor" /><path d="M1.5 7.5a7 7 0 0 1 7 7M1.5 2.5a12 12 0 0 1 12 12" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          {t("rssBoton", lang)}
        </a>
      </section>
    </div>
  </div>
</Base>

<style>
  .portada { padding-bottom: 5rem; }

  .lecturas { margin-bottom: 5rem; }
  .lecturas__cabecera {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.6rem 2rem;
    border-bottom: 2px solid var(--grafito); padding-bottom: 0.7rem; margin-bottom: 1.5rem;
  }
  .lecturas__cabecera h2 { font-size: clamp(1.9rem, 3.2vw, 2.4rem); }
  .lecturas__cabecera a { text-decoration: none; }

  .meta { display: flex; flex-wrap: wrap; gap: 0.2rem 0.55rem; white-space: nowrap; }
  .meta span + time::before { content: "·"; margin-right: 0.55rem; color: var(--gris); }

  .destacado {
    background: var(--blanco);
    padding: 2rem 2.2rem;
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 1.5rem 3rem;
    align-items: center;
  }
  .destacado__titulo { font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1.08; margin-top: 0.9rem; }
  .destacado__titulo a, .tarjeta__titulo a { text-decoration: none; }
  .destacado__titulo a:hover, .tarjeta__titulo a:hover { color: var(--rojo-texto); }
  .destacado__cuerpo { display: flex; flex-direction: column; align-items: flex-start; gap: 1.2rem; }
  .destacado__extracto { line-height: 1.55; }

  .tarjetas {
    list-style: none; margin: 1.5rem 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem;
  }
  .tarjeta {
    border-top: 2px solid var(--grafito);
    padding-top: 1rem;
    display: flex; flex-direction: column; gap: 0.7rem;
  }
  .tarjeta__titulo { font-size: 1.35rem; line-height: 1.15; }
  .tarjeta__extracto { font-size: 0.95rem; line-height: 1.55; color: var(--gris); }

  .cierre { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .caja {
    background: var(--blanco);
    border-top: 2px solid var(--grafito);
    padding: 1.5rem 1.6rem 1.7rem;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem;
  }
  .caja__titulo { font-size: 1.35rem; }
  .caja__texto { font-size: 1rem; line-height: 1.55; max-width: 34rem; }
  .caja .enlace-subrayado { text-decoration: none; }

  @media (max-width: 899px) {
    .destacado { grid-template-columns: minmax(0, 1fr); padding: 1.5rem 1.3rem; }
    .tarjetas { grid-template-columns: minmax(0, 1fr); }
    .cierre { grid-template-columns: minmax(0, 1fr); }
    .lecturas { margin-bottom: 3rem; }
    .portada { padding-bottom: 3rem; }
  }
</style>
