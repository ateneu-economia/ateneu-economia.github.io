---
// Archivo de artículos (todos, una sección o una etiqueta), con la barra lateral.
import Base from "../layouts/Base.astro";
import Lateral from "../components/Lateral.astro";
import ListaArticulos from "../components/ListaArticulos.astro";
import imagenesBanco from "../datos/imagenes.json";
import { t, ruta, articulosDe, imagenDe, copiasDe, type Articulo, type Lang } from "../lib/sitio";

interface Props {
  lang: Lang;
  titulo: string;
  otraLengua: string;
  articulos: Articulo[];
  categoria?: boolean;
  imagenes?: boolean;
  vacio?: string;
  // cabecera grande (Intervención, Docencia, Cuaderno de teoría), con enlaces opcionales a las secciones
  // imagen: clave del banco (src/datos/imagenes.json) para acompañar la cabecera, con su pie
  intro?: { rotulo: string; titulo: string; texto: string; lista?: string; enlaces?: { texto: string; href: string }[]; imagen?: string };
}
const { lang, titulo, otraLengua, articulos, categoria = true, imagenes = false, vacio, intro } = Astro.props;
const todos = await articulosDe(lang);
const H = intro ? "h2" : "h1";
const foto = intro?.imagen ? imagenesBanco.images.find((i) => i.key === intro.imagen) : undefined;
---

<Base lang={lang} titulo={titulo} otraLengua={otraLengua} imagenes={[...(foto ? [foto] : []), ...(imagenes ? articulos.map(imagenDe) : [])]}>
  {intro && (
    <header class:list={["intro envoltorio", { "intro--con-foto": foto }]}>
      <div class="intro__bloque">
        <p class="rotulo">{intro.rotulo}</p>
        <h1>{intro.titulo}</h1>
        <p class="intro__texto">{intro.texto}</p>
        {intro.enlaces && intro.enlaces.length > 0 && (
          <p class="intro__enlaces">{intro.enlaces.map((e) => <a class="rotulo enlace-subrayado" href={e.href}>{e.texto}</a>)}</p>
        )}
      </div>
      {foto && (
        <figure class="intro__foto">
          <div class="foto-papel"><img {...copiasDe(foto)} sizes="(max-width: 759px) 100vw, 40vw" alt={foto.alt[lang]} width={foto.width} height={foto.height} loading="eager" decoding="async" /></div>
          <figcaption>{foto.alt[lang]} <a class="rotulo rotulo--gris" href={foto.source}>{foto.credit}</a></figcaption>
        </figure>
      )}
    </header>
  )}
  <div class="envoltorio archivo">
    <section class="archivo__principal">
      <div class="archivo__cabecera">
        <H class:list={["archivo__titulo", { "archivo__titulo--pequeno": intro }]}>{intro ? intro.lista ?? t("articulos", lang) : titulo}</H>
        <a class="rotulo" href={ruta("rss", lang)}>RSS</a>
      </div>
      <ListaArticulos lang={lang} articulos={articulos} categoria={categoria} imagenes={imagenes} vacio={vacio} />
    </section>
    <Lateral lang={lang} articulos={todos} />
  </div>
</Base>

<style>
  .intro__enlaces { display: flex; flex-wrap: wrap; gap: 0.8rem 1.6rem; margin-top: 1.4rem; }
  .intro__enlaces a { text-decoration: none; }
  .intro { padding-top: 3rem; padding-bottom: 0.5rem; }
  .intro h1 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); margin: 1rem 0 1.1rem; }
  .intro__texto { font-size: 1.2rem; line-height: 1.55; max-width: 44rem; }
  /* Cabecera con foto (Docencia): texto y foto lado a lado, con pie que explica la imagen */
  .intro--con-foto {
    max-width: calc(var(--ancho) + 2 * var(--margen));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem;
    align-items: start;
  }
  .intro--con-foto .intro__bloque { padding-top: 0.5rem; }
  .intro__foto { margin: 0; }
  .intro__foto img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .intro__foto figcaption { font-size: 0.85rem; line-height: 1.45; color: var(--gris); margin-top: 0.6rem; }
  .intro__foto figcaption a { display: inline-block; margin-left: 0.3rem; font-size: 0.7rem; text-decoration: none; }
  @media (max-width: 759px) {
    .intro--con-foto { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; }
  }

  .archivo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 395px;
    gap: 3rem;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }
  .archivo__cabecera {
    display: flex; justify-content: space-between; align-items: flex-end;
    border-bottom: 2px solid var(--grafito);
    padding-bottom: 0.6rem;
  }
  .archivo__cabecera a { text-decoration: none; }
  .archivo__cabecera a:hover { color: var(--rojo-texto); }
  .archivo__titulo { font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
  .archivo__titulo--pequeno { font-size: 1.6rem; }

  @media (max-width: 999px) {
    .archivo { grid-template-columns: minmax(0, 1fr); }
  }
</style>
